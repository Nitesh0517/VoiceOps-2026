# VoiceOps 2026 Environment Configuration Example
# Copy this file to .env and fill in your credentials

# Gnani.ai Speech API Key (covers both STT and TTS)
# Obtain from https://app.gnani.ai/voice
GNANI_API_KEY=

# Optional LLM API Keys (for live neural generation)
# If left blank, the agent runs in high-precision offline reasoning mode
GEMINI_API_KEY=
OPENAI_API_KEY=

# Dataset & Agent Settings
REFERENCE_DATE=2026-10-20
DEBUG=False

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
